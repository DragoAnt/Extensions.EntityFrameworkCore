<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Squash an Entity Framework Core migration history into an initial migration while keeping existing databases on track.</Description>
        <Nullable>enable</Nullable>
        <NoWarn>EF1001;$(NoWarn)</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DragoAnt.EntityFrameworkCore.HistoricalMigrations.DependencyInjection"/>
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    </ItemGroup>

</Project>
